{
  "name": "futpass-app",
  "version": "1.0.0",
  "description": "Sistema FutPass com backend Node.js e persistência em MongoDB Atlas",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prestart": "npm run preflight",
    "start": "node server.js",
    "security:check": "powershell -ExecutionPolicy Bypass -File .\\scripts\\security-static-404-check.ps1",
    "migrate:json-to-mongo": "node .\\scripts\\migrate-json-to-mongo.js",
    "preflight": "node .\\scripts\\preflight-check.js",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File .\\scripts\\setup-windows.ps1"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "mongoose": "^9.9.1"
  }
}
