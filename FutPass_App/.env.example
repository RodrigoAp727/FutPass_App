NODE_ENV=production
PORT=3000
MONGO_URI=mongodb+srv://rodrigoapcampos92_db_user:SUA_SENHA_REAL@cluster0.bpinogl.mongodb.net/futpass?retryWrites=true&w=majority
USE_SECURE_COOKIES=true
CORS_ALLOWED_ORIGIN=
# Opcional: multiplas origens separadas por virgula
CORS_ALLOWED_ORIGINS=
# Forca validacao de Origin/Referer para POST/PUT/PATCH/DELETE em /api/* (recomendado true em producao)
ENFORCE_ORIGIN_ON_STATE_CHANGES=true
# Limites de taxa por IP na janela de 15 min
RATE_LIMIT_MAX_API=600
RATE_LIMIT_MAX_AUTH=80
# Limite de bloqueio por tentativas invalidas de login
MAX_FAILED_LOGINS=5
FAILED_LOGIN_WINDOW_MS=900000